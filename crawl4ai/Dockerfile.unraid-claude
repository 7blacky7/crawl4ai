# ================================================================
# Crawl4AI + Claude OAuth fuer Unraid
# ================================================================
# Dieses Dockerfile erweitert crawl4ai um Claude CLI Support,
# damit du dein Max-Abo nutzen kannst ohne API-Keys!
#
# Build:
#   docker build -f Dockerfile.unraid-claude -t crawl4ai-claude .
#
# Run:
#   docker run -d \
#     -p 11235:11235 \
#     -v /mnt/user/appdata/crawl4ai-claude:/home/appuser/.claude \
#     -e CLAUDE_AUTH_TOKEN=your_oauth_token \
#     crawl4ai-claude
#
# ================================================================

FROM python:3.12-slim-bookworm AS build

# C4ai version
ARG C4AI_VER=0.8.0-claude
ENV C4AI_VERSION=$C4AI_VER
LABEL c4ai.version=$C4AI_VER
LABEL maintainer="7blacky7"
LABEL description="Crawl4AI mit Claude OAuth Support fuer Unraid"

# Set build arguments
ARG APP_HOME=/app
ARG USE_LOCAL=true

ENV PYTHONFAULTHANDLER=1 \
    PYTHONHASHSEED=random \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100 \
    DEBIAN_FRONTEND=noninteractive \
    REDIS_HOST=localhost \
    REDIS_PORT=6379

ARG INSTALL_TYPE=default
ARG TARGETARCH

# ================================================================
# System Dependencies + Node.js fuer Claude CLI
# ================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    wget \
    gnupg \
    git \
    cmake \
    pkg-config \
    python3-dev \
    libjpeg-dev \
    redis-server \
    supervisor \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Node.js fuer Claude CLI
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Browser dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxcb1 \
    libxkbcommon0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get dist-upgrade -y \
    && rm -rf /var/lib/apt/lists/*

# ARM64 optimizations (fuer Unraid auf ARM)
RUN if [ "$TARGETARCH" = "arm64" ]; then \
    echo "Installing ARM-specific optimizations"; \
    apt-get update && apt-get install -y --no-install-recommends \
    libopenblas-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*; \
elif [ "$TARGETARCH" = "amd64" ]; then \
    echo "Installing AMD64-specific optimizations"; \
    apt-get update && apt-get install -y --no-install-recommends \
    libomp-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*; \
fi

# ================================================================
# Claude CLI Installation
# ================================================================
RUN npm install -g @anthropic-ai/claude-code \
    && claude --version || echo "Claude CLI installed"

# Create non-root user
RUN groupadd -r appuser && useradd --no-log-init -r -g appuser appuser

# Create home directories
RUN mkdir -p /home/appuser/.claude \
    && mkdir -p /home/appuser/.config \
    && chown -R appuser:appuser /home/appuser

WORKDIR ${APP_HOME}

# Copy project files
COPY . /tmp/project/
COPY deploy/docker/supervisord.conf .
COPY deploy/docker/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install crawl4ai
RUN pip install "/tmp/project" \
    && python -c "import crawl4ai; print('crawl4ai is ready!')"

RUN crawl4ai-setup
RUN playwright install --with-deps

# Copy Playwright to appuser
RUN mkdir -p /home/appuser/.cache/ms-playwright \
    && cp -r /root/.cache/ms-playwright/chromium-* /home/appuser/.cache/ms-playwright/ \
    && chown -R appuser:appuser /home/appuser/.cache/ms-playwright

RUN crawl4ai-doctor || true

# Cache directories
RUN mkdir -p /home/appuser/.cache \
    && chown -R appuser:appuser /home/appuser/.cache

# Copy application code
COPY deploy/docker/* ${APP_HOME}/
COPY deploy/docker/static ${APP_HOME}/static

# Change ownership
RUN chown -R appuser:appuser ${APP_HOME}

# Redis dirs
RUN mkdir -p /var/lib/redis /var/log/redis && chown -R appuser:appuser /var/lib/redis /var/log/redis

# ================================================================
# Claude OAuth Startup Script
# ================================================================
RUN echo '#!/bin/bash\n\
# Claude OAuth Token Setup\n\
if [ -n "$CLAUDE_AUTH_TOKEN" ]; then\n\
    echo "Setting up Claude OAuth token..."\n\
    mkdir -p /home/appuser/.claude\n\
    echo "$CLAUDE_AUTH_TOKEN" > /home/appuser/.claude/.credentials\n\
    chown -R appuser:appuser /home/appuser/.claude\n\
fi\n\
\n\
# Wichtig: ANTHROPIC_API_KEY entfernen damit OAuth genutzt wird\n\
unset ANTHROPIC_API_KEY\n\
\n\
exec supervisord -c supervisord.conf' > /app/entrypoint.sh \
    && chmod +x /app/entrypoint.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD bash -c '\
    MEM=$(free -m | awk "/^Mem:/{print \$2}"); \
    if [ $MEM -lt 2048 ]; then \
        echo "Warning: Less than 2GB RAM available!"; \
        exit 1; \
    fi && \
    redis-cli ping > /dev/null && \
    curl -f http://localhost:11235/health || exit 1'

EXPOSE 11235
EXPOSE 6379

# Volume fuer Claude credentials
VOLUME ["/home/appuser/.claude"]

USER appuser

ENV PYTHON_ENV=production

# Entrypoint mit OAuth Setup
ENTRYPOINT ["/app/entrypoint.sh"]
